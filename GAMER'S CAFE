<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>THE GAMER'S CAFE| Luxury Gaming Experience</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root{
    --bg:#050509;
    --bg2:#0b0b12;
    --card:rgba(18,18,28,.72);
    --gold:#d7b56d;
    --gold2:#f4d895;
    --purple:#8b5cf6;
    --cyan:#00e5ff;
    --pink:#ff2bd6;
    --white:#fff;
    --muted:#a6a6b3;
    --border:rgba(255,255,255,.1);
    --shadow:0 25px 80px rgba(0,0,0,.5);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:
        radial-gradient(circle at 20% 10%,rgba(139,92,246,.12),transparent 30%),
        radial-gradient(circle at 85% 20%,rgba(0,229,255,.08),transparent 28%),
        var(--bg);
    color:var(--white);
    font-family:Poppins,sans-serif;
    overflow-x:hidden;
}

a{
    color:inherit;
    text-decoration:none;
}

button,input,select{
    font:inherit;
}

.container{
    width:min(1180px,92%);
    margin:auto;
}

/* LOADER */

.loader{
    position:fixed;
    inset:0;
    background:#050509;
    z-index:9999;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    transition:1s;
}

.loader-logo{
    font-family:Orbitron;
    font-size:30px;
    font-weight:900;
    letter-spacing:4px;
    color:var(--gold2);
    text-shadow:0 0 30px rgba(215,181,109,.6);
}

.loader-line{
    width:220px;
    height:2px;
    background:#222;
    margin-top:20px;
    overflow:hidden;
}

.loader-line span{
    display:block;
    width:0;
    height:100%;
    background:var(--gold);
    animation:loading 2s forwards;
}

@keyframes loading{
    to{width:100%}
}

/* NAVBAR */

.navbar{
    position:fixed;
    top:0;
    left:0;
    right:0;
    z-index:1000;
    padding:18px 0;
    transition:.4s;
}

.navbar.scrolled{
    background:rgba(5,5,9,.82);
    backdrop-filter:blur(20px);
    border-bottom:1px solid var(--border);
}

.nav-inner{
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
    font-family:Orbitron;
    font-weight:900;
    letter-spacing:2px;
}

.logo-icon{
    width:42px;
    height:42px;
    border:1px solid var(--gold);
    display:grid;
    place-items:center;
    border-radius:12px;
    color:var(--gold2);
    box-shadow:0 0 25px rgba(215,181,109,.18);
}

.logo span{
    color:var(--gold2);
}

.nav-links{
    display:flex;
    gap:30px;
    list-style:none;
}

.nav-links a{
    color:#ccc;
    font-size:13px;
    transition:.3s;
}

.nav-links a:hover{
    color:var(--gold2);
}

.nav-btn{
    padding:11px 20px;
    border:1px solid var(--gold);
    border-radius:30px;
    color:var(--gold2);
    font-size:13px;
    transition:.3s;
}

.nav-btn:hover{
    background:var(--gold);
    color:#080808;
}

.menu{
    display:none;
    font-size:26px;
    cursor:pointer;
}

/* HERO */

.hero{
    min-height:100vh;
    position:relative;
    display:flex;
    align-items:center;
    overflow:hidden;
}

.hero-bg{
    position:absolute;
    inset:0;
    background:
        linear-gradient(90deg,rgba(5,5,9,.98),rgba(5,5,9,.65),rgba(5,5,9,.2)),
        url("https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=2000&q=85")
        center/cover;
    z-index:-2;
}

.hero::after{
    content:"";
    position:absolute;
    inset:0;
    background:
        linear-gradient(to bottom,transparent 70%,var(--bg)),
        radial-gradient(circle at 80% 50%,rgba(139,92,246,.18),transparent 35%);
    z-index:-1;
}

.hero-content{
    max-width:720px;
    padding-top:70px;
}

.badge{
    display:inline-flex;
    align-items:center;
    gap:9px;
    padding:8px 14px;
    border:1px solid rgba(215,181,109,.35);
    background:rgba(215,181,109,.06);
    border-radius:30px;
    color:var(--gold2);
    font-size:11px;
    letter-spacing:2px;
    text-transform:uppercase;
}

.status-dot{
    width:7px;
    height:7px;
    background:#54ff7c;
    border-radius:50%;
    box-shadow:0 0 12px #54ff7c;
}

.hero h1{
    font-family:Orbitron;
    font-size:clamp(48px,7vw,92px);
    line-height:.95;
    margin:25px 0;
    letter-spacing:-4px;
}

.hero h1 .gold{
    color:var(--gold2);
}

.hero h1 .outline{
    color:transparent;
    -webkit-text-stroke:1px rgba(255,255,255,.55);
}

.hero p{
    color:#c0c0ca;
    max-width:580px;
    line-height:1.8;
    font-size:15px;
}

.hero-buttons{
    display:flex;
    gap:15px;
    margin-top:35px;
}

.btn{
    border:none;
    cursor:pointer;
    padding:14px 24px;
    border-radius:5px;
    font-size:13px;
    font-weight:600;
    transition:.3s;
}

.btn-gold{
    background:linear-gradient(135deg,var(--gold2),var(--gold));
    color:#111;
    box-shadow:0 10px 35px rgba(215,181,109,.2);
}

.btn-gold:hover{
    transform:translateY(-3px);
    box-shadow:0 15px 45px rgba(215,181,109,.35);
}

.btn-outline{
    border:1px solid rgba(255,255,255,.2);
    background:rgba(255,255,255,.04);
    color:white;
}

.btn-outline:hover{
    border-color:var(--gold);
}

.hero-stats{
    display:flex;
    gap:45px;
    margin-top:60px;
}

.stat strong{
    display:block;
    font-family:Orbitron;
    font-size:25px;
    color:var(--gold2);
}

.stat span{
    color:#858591;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:1px;
}

/* SECTIONS */

section{
    padding:110px 0;
}

.section-head{
    text-align:center;
    margin-bottom:55px;
}

.eyebrow{
    color:var(--gold2);
    text-transform:uppercase;
    font-size:11px;
    letter-spacing:4px;
}

.section-head h2{
    font-family:Orbitron;
    font-size:clamp(30px,5vw,52px);
    margin:12px 0;
}

.section-head p{
    color:var(--muted);
    max-width:600px;
    margin:auto;
    font-size:14px;
}

/* EXPERIENCE */

.experience-grid{
    display:grid;
    grid-template-columns:1.3fr .7fr;
    gap:20px;
}

.exp-card{
    position:relative;
    min-height:400px;
    border:1px solid var(--border);
    overflow:hidden;
    border-radius:16px;
    background:#111;
}

.exp-card.small{
    min-height:190px;
}

.exp-image{
    position:absolute;
    inset:0;
    background-size:cover;
    background-position:center;
    transition:.6s;
}

.exp-card:hover .exp-image{
    transform:scale(1.06);
}

.exp-card:nth-child(1) .exp-image{
    background-image:
    linear-gradient(0deg,rgba(0,0,0,.85),transparent),
    url("https://images.unsplash.com/photo-1593305841991-05c297ba4575?auto=format&fit=crop&w=1000&q=80");
}

.exp-card:nth-child(2) .exp-image{
    background-image:
    linear-gradient(0deg,rgba(0,0,0,.9),transparent),
    url("https://images.unsplash.com/photo-1606144042614-b2417e99c4e3?auto=format&fit=crop&w=900&q=80");
}

.exp-card:nth-child(3) .exp-image{
    background-image:
    linear-gradient(0deg,rgba(0,0,0,.9),transparent),
    url("https://images.unsplash.com/photo-1578926288207-a90a5366759d?auto=format&fit=crop&w=900&q=80");
}

.exp-content{
    position:absolute;
    bottom:0;
    padding:30px;
}

.exp-content h3{
    font-family:Orbitron;
    font-size:23px;
}

.exp-content p{
    color:#aaa;
    font-size:12px;
    margin-top:6px;
}

/* SPECS */

.specs{
    background:linear-gradient(180deg,transparent,rgba(139,92,246,.04),transparent);
}

.spec-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.spec-card{
    padding:28px 20px;
    background:var(--card);
    border:1px solid var(--border);
    border-radius:12px;
    text-align:center;
    transition:.4s;
}

.spec-card:hover{
    transform:translateY(-8px);
    border-color:rgba(215,181,109,.45);
}

.spec-icon{
    font-size:28px;
    margin-bottom:15px;
}

.spec-card h3{
    font-family:Orbitron;
    font-size:15px;
}

.spec-card p{
    color:#858591;
    font-size:11px;
    margin-top:8px;
}

/* PRICING */

.pricing-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.price-card{
    position:relative;
    background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.02));
    border:1px solid var(--border);
    padding:35px;
    border-radius:15px;
    transition:.4s;
}

.price-card.featured{
    border-color:var(--gold);
    box-shadow:0 20px 60px rgba(215,181,109,.1);
    transform:scale(1.03);
}

.popular{
    position:absolute;
    top:15px;
    right:15px;
    font-size:9px;
    padding:6px 10px;
    background:var(--gold);
    color:#111;
    border-radius:20px;
    font-weight:bold;
}

.price-card h3{
    font-family:Orbitron;
    font-size:19px;
}

.price{
    font-family:Orbitron;
    font-size:38px;
    margin:20px 0;
    color:var(--gold2);
}

.price span{
    font-size:11px;
    color:#888;
}

.features{
    list-style:none;
    border-top:1px solid var(--border);
    padding-top:20px;
}

.features li{
    font-size:12px;
    color:#bbb;
    padding:8px 0;
}

.features li::before{
    content:"✓";
    color:var(--gold2);
    margin-right:10px;
}

.full-btn{
    width:100%;
    margin-top:25px;
}

/* MENU */

.menu-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:16px;
}

.menu-item{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:12px;
    overflow:hidden;
    transition:.3s;
}

.menu-item:hover{
    transform:translateY(-5px);
}

.menu-img{
    height:180px;
    background-size:cover;
    background-position:center;
}

.menu-item:nth-child(1) .menu-img{
    background-image:url("https://images.unsplash.com/photo-1572490122747-3968b75cc699?auto=format&fit=crop&w=800&q=80");
}

.menu-item:nth-child(2) .menu-img{
    background-image:url("https://images.unsplash.com/photo-1579751626657-72bc17010498?auto=format&fit=crop&w=800&q=80");
}

.menu-item:nth-child(3) .menu-img{
    background-image:url("https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=800&q=80");
}

.menu-info{
    padding:20px;
    display:flex;
    justify-content:space-between;
    gap:10px;
}

.menu-info h3{
    font-size:14px;
}

.menu-info p{
    color:#888;
    font-size:10px;
    margin-top:5px;
}

.menu-price{
    color:var(--gold2);
    font-family:Orbitron;
    font-size:13px;
}

/* TOURNAMENT */

.tournament{
    position:relative;
    border:1px solid rgba(139,92,246,.25);
    border-radius:20px;
    overflow:hidden;
    padding:70px;
    background:
        linear-gradient(90deg,rgba(5,5,9,.95),rgba(5,5,9,.55)),
        url("https://images.unsplash.com/photo-1547394765-185e1e68f34e?auto=format&fit=crop&w=1600&q=85")
        center/cover;
}

.tournament h2{
    font-family:Orbitron;
    font-size:42px;
    max-width:600px;
}

.tournament p{
    color:#bbb;
    max-width:550px;
    margin:15px 0 25px;
    font-size:14px;
}

.prize{
    display:inline-block;
    color:var(--gold2);
    font-family:Orbitron;
    font-size:25px;
    margin-bottom:20px;
}

/* BOOKING */

.booking-wrapper{
    display:grid;
    grid-template-columns:.8fr 1.2fr;
    gap:20px;
}

.booking-info{
    padding:40px;
    border:1px solid var(--border);
    background:var(--card);
    border-radius:15px;
}

.booking-info h3{
    font-family:Orbitron;
    font-size:24px;
}

.booking-info p{
    color:#999;
    font-size:13px;
    line-height:1.8;
    margin:15px 0;
}

.contact-item{
    padding:15px 0;
    border-top:1px solid var(--border);
    font-size:12px;
    color:#bbb;
}

.booking-form{
    padding:40px;
    background:rgba(255,255,255,.035);
    border:1px solid var(--border);
    border-radius:15px;
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

.field{
    display:flex;
    flex-direction:column;
    gap:7px;
}

.field.full{
    grid-column:1/-1;
}

.field label{
    color:#888;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:1px;
}

.field input,
.field select{
    background:#0b0b11;
    border:1px solid #252530;
    padding:13px;
    border-radius:7px;
    color:white;
    outline:none;
}

.field input:focus,
.field select:focus{
    border-color:var(--gold);
}

.booking-form .btn{
    margin-top:20px;
}

/* TESTIMONIAL */

.testimonial-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.review{
    background:var(--card);
    border:1px solid var(--border);
    padding:28px;
    border-radius:13px;
}

.stars{
    color:var(--gold2);
    letter-spacing:3px;
}

.review p{
    color:#aaa;
    font-size:13px;
    line-height:1.8;
    margin:15px 0;
}

.reviewer{
    font-size:12px;
    font-weight:bold;
}

.reviewer span{
    color:#777;
    font-weight:normal;
}

/* FOOTER */

footer{
    border-top:1px solid var(--border);
    padding:50px 0 25px;
}

.footer-grid{
    display:grid;
    grid-template-columns:1.4fr 1fr 1fr 1fr;
    gap:40px;
}

.footer-brand p{
    color:#777;
    font-size:12px;
    line-height:1.8;
    max-width:280px;
    margin-top:15px;
}

footer h4{
    font-family:Orbitron;
    font-size:12px;
    margin-bottom:18px;
}

footer ul{
    list-style:none;
}

footer li{
    color:#777;
    font-size:11px;
    padding:6px 0;
}

footer li:hover{
    color:var(--gold2);
}

.copyright{
    border-top:1px solid var(--border);
    margin-top:40px;
    padding-top:20px;
    display:flex;
    justify-content:space-between;
    color:#555;
    font-size:10px;
}

/* FLOATING */

.cursor-glow{
    position:fixed;
    width:300px;
    height:300px;
    border-radius:50%;
    pointer-events:none;
    background:radial-gradient(circle,rgba(139,92,246,.08),transparent 65%);
    transform:translate(-50%,-50%);
    z-index:-1;
}

/* REVEAL */

.reveal{
    opacity:0;
    transform:translateY(35px);
    transition:1s;
}

.reveal.active{
    opacity:1;
    transform:translateY(0);
}

/* RESPONSIVE */

@media(max-width:900px){

    .nav-links{
        position:absolute;
        top:75px;
        left:4%;
        right:4%;
        display:none;
        flex-direction:column;
        background:#0b0b11;
        padding:25px;
        border:1px solid var(--border);
        border-radius:12px;
    }

    .nav-links.active{
        display:flex;
    }

    .menu{
        display:block;
    }

    .nav-btn{
        display:none;
    }

    .experience-grid,
    .booking-wrapper{
        grid-template-columns:1fr;
    }

    .spec-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .pricing-grid,
    .testimonial-grid{
        grid-template-columns:1fr;
    }

    .price-card.featured{
        transform:none;
    }

    .menu-grid{
        grid-template-columns:1fr 1fr;
    }

    .footer-grid{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:600px){

    section{
        padding:80px 0;
    }

    .hero h1{
        font-size:45px;
        letter-spacing:-2px;
    }

    .hero-buttons{
        flex-direction:column;
    }

    .hero-stats{
        gap:20px;
        flex-wrap:wrap;
    }

    .stat strong{
        font-size:20px;
    }

    .spec-grid,
    .menu-grid,
    .footer-grid,
    .form-grid{
        grid-template-columns:1fr;
    }

    .field.full{
        grid-column:auto;
    }

    .tournament{
        padding:40px 25px;
    }

    .tournament h2{
        font-size:30px;
    }

    .copyright{
        flex-direction:column;
        gap:10px;
    }
}
</style>
</head>

<body>

<!-- LOADER -->
<div class="loader" id="loader">
    <div class="loader-logo">THE GAMER'S CAFÉ</div>
    <div class="loader-line"><span></span></div>
</div>

<!-- CURSOR GLOW -->
<div class="cursor-glow" id="cursorGlow"></div>

<!-- NAVBAR -->
<header class="navbar" id="navbar">
    <div class="container nav-inner">

        <a href="#" class="logo">
            <div class="logo-icon">GC</div>
            <div>GAMER'S <span>CAFE</span></div>
        </a>

        <nav>
            <ul class="nav-links" id="navLinks">
                <li><a href="#experience">Experience</a></li>
                <li><a href="#systems">Systems</a></li>
                <li><a href="#memberships">Membership</a></li>
                <li><a href="#menu">Café</a></li>
            </ul>
        </nav>

        <a href="#booking" class="nav-btn">BOOK A SESSION</a>

        <div class="menu" id="menuBtn">☰</div>
    </div>
</header>

<!-- HERO -->
<section class="hero">

    <div class="hero-bg"></div>

    <div class="container">
        <div class="hero-content reveal">

            <div class="badge">
                <span class="status-dot"></span>
                Now Open • Salem
            </div>

            <h1>
                PLAY<br>
                <span class="gold">BEYOND</span><br>
                <span class="outline">LIMITS.</span>
            </h1>

            <p>
                A next-generation luxury gaming café designed for competitive
                gamers, casual players, creators and esports communities.
                Premium hardware. Private rooms. Exceptional coffee.
            </p>

            <div class="hero-buttons">
                <a href="#booking" class="btn btn-gold">RESERVE YOUR SETUP →</a>
                <a href="#experience" class="btn btn-outline">EXPLORE EXPERIENCE</a>
            </div>

            <div class="hero-stats">
                <div class="stat">
                    <strong>LUXURY</strong>
                    <span>Gaming Stations</span>
                </div>

                <div class="stat">
                    <strong>4K</strong>
                    <span>Ultra HD</span>
                </div>

                <div class="stat">
                    <strong>240Hz</strong>
                    <span>Competitive Play</span>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- EXPERIENCE -->
<section id="experience">
    <div class="container">

        <div class="section-head reveal">
            <div class="eyebrow">The Experience</div>
            <h2>BUILT FOR GAMERS.</h2>
            <p>
                Every detail is engineered to make your gaming session
                faster, smoother and more immersive.
            </p>
        </div>

        <div class="experience-grid reveal">

            <div class="exp-card">
                <div class="exp-image"></div>
                <div class="exp-content">
                    <h3>ELITE PC ARENA</h3>
                    <p>RTX-powered gaming rigs • 240Hz displays • Mechanical keyboards</p>
                </div>
            </div>

            <div style="display:grid;gap:20px;">

                <div class="exp-card small">
                    <div class="exp-image"></div>
                    <div class="exp-content">
                        <h3>CONSOLE LOUNGE</h3>
                        <p>Next-gen consoles • 4K displays • Premium controllers</p>
                    </div>
                </div>

                <div class="exp-card small">
                    <div class="exp-image"></div>
                    <div class="exp-content">
                        <h3>PRIVATE ROOMS</h3>
                        <p>Squad gaming • Streaming • Events</p>
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>

